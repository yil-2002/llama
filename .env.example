# --- Telegram ---
BOT_TOKEN=123456:ABC...
# Mini App manzili (HTTPS, masalan https://owly.example.uz)
WEBAPP_URL=https://owly.example.uz
# Adminlar Telegram ID lari (dashboard, /stats, /setmodel)
ADMIN_IDS=[123456789]

# --- Ma'lumotlar bazasi va navbat (docker compose uchun shunday qoldiring) ---
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/englishbot
REDIS_URL=redis://redis:6379/0

# --- AI model (OpenAI-mos API) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# DeepSeek kabinetidagi aniq model nomini yozing; keyin bot ichida /setmodel bilan almashtirsa bo'ladi
LLM_MODEL=deepseek-v4.1-flash

# --- Ovoz (ixtiyoriy). "openai" = OpenAI-mos /audio API, "none" = o'chiq ---
STT_PROVIDER=none
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
TTS_PROVIDER=none
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Limit va narxlar ---
FREE_DAILY_MESSAGES=15
TRIAL_DAYS=3
PREMIUM_STARS_PRICE=300

# --- To'lov: hozir faqat Stars. MChJ/YaTT tayyor bo'lgach: stars,click,payme ---
PAYMENT_PROVIDERS=stars
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PREMIUM_UZS_PRICE=49000
EXTERNAL_PAY_URL=

# --- Maskot stikerlari (ixtiyoriy, @Stickers dan olingan file_id) ---
STICKER_HELLO=
STICKER_THINK=
STICKER_PRAISE=
STICKER_SAD=
